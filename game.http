@host = http://localhost:5204
# Paste the token from login/register here, then run the authorized writes below
@token = PASTE-TOKEN-HERE

### Get hello world
GET {{host}}/

### Minimal: get all games
GET {{host}}/games

### Minimal: get game by id
GET {{host}}/games/1

### Minimal: create a game (genreId from GET /genres, needs token)
POST {{host}}/games
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Hollow Knight",
  "genreId": 16,
  "price": 14.99,
  "releaseDate": "2017-02-24"
}

### Minimal: list genres
GET {{host}}/genres

### MVC: get all games
GET {{host}}/api/Games

### MVC: list genres
GET {{host}}/api/Genres

### MVC: update a game (needs token)
PUT {{host}}/api/Games/1
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Spacewar Deluxe",
  "genreId": 9,
  "price": 4.99,
  "releaseDate": "1962-10-19"
}

### Minimal: delete a game (needs token)
DELETE {{host}}/games/1
Authorization: Bearer {{token}}

### Auth: register (minimal, open)
POST {{host}}/auth/register
Content-Type: application/json

{
  "username": "player1",
  "password": "S3cret-pass!"
}

### Auth: login (minimal, open)
POST {{host}}/auth/login
Content-Type: application/json

{
  "username": "player1",
  "password": "S3cret-pass!"
}

### Minimal: create a game (authorized)
POST {{host}}/games
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Hollow Knight",
  "genreId": 16,
  "price": 14.99,
  "releaseDate": "2017-02-24"
}

### MVC: register
POST {{host}}/api/Auth/register
Content-Type: application/json

{
  "username": "player1",
  "password": "S3cret-pass!"
}

### MVC: login
POST {{host}}/api/Auth/login
Content-Type: application/json

{
  "username": "player1",
  "password": "S3cret-pass!"
}

### MVC: create a game (authorized)
POST {{host}}/api/Games
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Celeste",
  "genreId": 16,
  "price": 19.99,
  "releaseDate": "2018-01-25"
}